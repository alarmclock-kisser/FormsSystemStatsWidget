<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Ressources\FSS_Widget.favicon.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <Title>FSSW-Widget</Title>
    <Authors>alarmclock-kisser</Authors>
    <Company>AKAZUEFFLI</Company>
    <Product>FSSWidget</Product>
    <Description>Forms System Statistics Widget</Description>
    <PackageProjectUrl>https://github.com/alarmclock-kisser/FormsSystemStatsWidget</PackageProjectUrl>
    <PackageIcon>FSS_Widget.favicon.png</PackageIcon>
    <RepositoryUrl>https://github.com/alarmclock-kisser/FormsSystemStatsWidget</RepositoryUrl>
    <PackageTags>statistics; monitor; widget; forms; system;</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <IncludeSymbols>False</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Ressources\FSS_Widget.favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Ressources\FSS_Widget.favicon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\*.py" CopyToOutputDirectory="Always" />
    <Content Include="Ressources\LlamaCppLoad_BATs\*.BAT" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormsSystemStatsWidget.Core\FormsSystemStatsWidget.Core.csproj" />
    <ProjectReference Include="..\FormsSystemStatsWidget.OnnxGenaiServer\FormsSystemStatsWidget.OnnxGenaiServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenHardwareMonitorLib" Version="1.0.9513" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Ressources\FSS_Widget.favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Ressources\Logs\" />
    <Folder Include="Ressources\LlamaCppLoad_BATs\" />
  </ItemGroup>

  <Target Name="CopyOnnxGenaiServerForWidgetBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <OnnxGenaiServerBuildFiles Include="$(MSBuildProjectDirectory)\..\FormsSystemStatsWidget.OnnxGenaiServer\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(OnnxGenaiServerBuildFiles)" DestinationFiles="@(OnnxGenaiServerBuildFiles->'$(TargetDir)OnnxGenaiServer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishOnnxGenaiServerForWidget" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <!-- OnnxGenaiServer ist net10.0 (Web-SDK) ohne -windows: kein RID-Publish,
         stattdessen framework-dependent, damit project.assets.json nicht nach
         einem win-x64-Ziel sucht, das es nie hatte. -->
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\FormsSystemStatsWidget.OnnxGenaiServer\FormsSystemStatsWidget.OnnxGenaiServer.csproj" Targets="Publish" Properties="Configuration=$(Configuration);SelfContained=false;PublishSingleFile=false;PublishDir=$(PublishDir)OnnxGenaiServer\" />
  </Target>

</Project>